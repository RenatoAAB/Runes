[gd_resource type="Resource" script_class="GameEffect" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/effects/game_effect.gd" id="1_ge"]
[ext_resource type="Script" path="res://scripts/effects/actions/action_buff_activation.gd" id="2_ab"]
[ext_resource type="Script" path="res://scripts/effects/value_resolver.gd" id="3_vr"]
[ext_resource type="Script" path="res://scripts/effects/selectors/selector_column.gd" id="4_sc"]
[ext_resource type="Script" path="res://scripts/effects/conditions/condition_remaining_activations.gd" id="5_cond"]

[sub_resource type="Resource" id="sel"]
script = ExtResource("4_sc")
include_self = false

[sub_resource type="Resource" id="cond"]
script = ExtResource("5_cond")
threshold = 0
comparison = 2

[sub_resource type="Resource" id="vr"]
script = ExtResource("3_vr")
base = 1.0

[sub_resource type="Resource" id="act"]
script = ExtResource("2_ab")
value = SubResource("vr")

[resource]
script = ExtResource("1_ge")
condition = SubResource("cond")
selector = SubResource("sel")
action = SubResource("act")